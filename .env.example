# Copy this file to .env and fill in the key. Every setting in config.py can be set here.

# OpenRouter key (for the LLM)
LLM_API_OR=sk-or-...

# LLM that pulls out claims, compares them and writes answers
LLM_MODEL=openai/gpt-6-luna

# Dataset: helios (default) | brightwater. --dataset on the command line wins over this.
# DATASET=helios

# Qdrant: embedded (folder ./qdrant_data) | server (QDRANT_URL)
QDRANT_MODE=embedded
# QDRANT_URL=http://localhost:6333

# LangSmith tracing (optional; everything works with it off)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=rag-conflicts
